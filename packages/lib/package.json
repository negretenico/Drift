  "devDependencies": {
    "@types/node": "^20.0.0",
    "fake-indexeddb": "^5.0.0",
    "happy-dom": "^12.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  }
}
